#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for its short-lived
# artifacts: task briefs, implementer reports, review packages, and the
# progress ledger. Print the directory's absolute path.
#
# With PLAN_FILE, the workspace is scoped to that plan
# (.toolbelt/sdd/<plan-basename>/) so a follow-up plan in the same working
# tree can never read or overwrite another plan's artifacts. Two plans both
# have a "Task 2"; unscoped, the second overwrites the first's brief, and a
# stale ledger misread as current progress makes controllers skip whole task
# sequences. Plan-scoping removes both failures structurally.
#
# Without PLAN_FILE the shared base directory is used. Callers with no plan —
# requesting-code-review, quick-task — belong there.
#
# The workspace lives in the working tree (not under .git/) because Claude Code
# treats .git/ as a protected path and denies agent writes there — which blocks
# an implementer subagent from writing its report file. A self-ignoring
# .gitignore at the base keeps every plan's workspace out of `git status` and
# out of accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# Usage: sdd-workspace [PLAN_FILE]
set -euo pipefail

if [ $# -gt 1 ]; then
  echo "usage: sdd-workspace [PLAN_FILE]" >&2
  exit 2
fi

root=$(git rev-parse --show-toplevel)
base="$root/.toolbelt/sdd"
dir="$base"

if [ $# -eq 1 ]; then
  plan=$1
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  # Basename alone collides across directories (docs/a/foo.md vs docs/b/foo.md),
  # so a short digest of the path relative to the repo root disambiguates while
  # keeping the directory readable. Deterministic, so resume finds the same one.
  rel=$(git -C "$root" ls-files --full-name --error-unmatch "$plan" 2>/dev/null) \
    || rel=$(realpath --relative-to="$root" "$plan" 2>/dev/null) || rel=$plan
  slug=$(basename "$plan" .md)
  [ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
    || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }
  digest=$(printf '%s' "$rel" | git hash-object --stdin | cut -c1-6)
  dir="$base/$slug-$digest"
fi

mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd
