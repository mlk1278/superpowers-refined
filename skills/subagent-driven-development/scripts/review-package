#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package [--plan PLAN_FILE] BASE HEAD [OUTFILE]
# Default OUTFILE: <workspace>/review-<base7>..<head7>.diff, named per range so
# a re-review after fixes gets a distinct fresh file. --plan scopes the
# workspace to one plan; without it the shared base directory is used, which is
# what callers with no plan (requesting-code-review, quick-task) want.
set -euo pipefail

usage() { echo "usage: review-package [--plan PLAN_FILE] BASE HEAD [OUTFILE]" >&2; exit 2; }

plan=
if [ "${1-}" = "--plan" ]; then
  [ $# -ge 2 ] || usage
  plan=$2
  shift 2
fi

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  usage
fi

base=$1
head=$2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  workspace="$(cd "$(dirname "$0")" && pwd)/sdd-workspace"
  if [ -n "$plan" ]; then
    dir=$("$workspace" "$plan")
  else
    dir=$("$workspace")
  fi
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
